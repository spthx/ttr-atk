{
  "name": "ttr-atk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:game": "vite --config vite.game.config.ts --port=3000 --host=0.0.0.0",
    "build:game": "vite build --config vite.game.config.ts --outDir public/game --emptyOutDir",
    "build:pages": "vite build --config vite.game.config.ts --outDir dist --emptyOutDir",
    "dev": "vinext dev",
    "build": "npm run build:game && vinext build",
    "start": "vinext start",
    "lint": "tsc --noEmit",
    "check:balance": "tsx scripts/check-balance.ts",
    "check:progression": "tsx scripts/check-progression-navigation.ts",
    "check:readiness": "tsx scripts/check-readiness-mechanics.ts",
    "check:simulations": "tsx scripts/check-battle-simulations.ts",
    "check:visuals": "tsx scripts/check-visual-regressions.ts && npm run check:capital-contact",
    "check:capital-contact": "tsx scripts/check-capital-contact.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.19.19",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "autoprefixer": "^10.4.21",
    "pngjs": "^7.0.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
